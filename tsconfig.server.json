{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist/server",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "server/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "electron",
    "src/index.tsx",
    "src/App.tsx",
    "src/App.css",
    "src/components/**/*",
    "src/mockElectronAPI.ts",
    "src/httpApi.ts"
  ]
}
